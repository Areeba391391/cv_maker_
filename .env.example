# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shown on Contact page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
AI_PROVIDER=ollama

# Ollama (local or remote)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=90000
# Fail fast (~10s) and finish with typed fields if AI is slow
OLLAMA_SOFT_TIMEOUT_MS=10000

# Speech / OCR (optional overrides) — tiny Whisper avoids Node OOM crashes
WHISPER_MODEL=Xenova/whisper-tiny
OCR_LANGUAGE=eng
MAX_UPLOAD_BYTES=15728640
MAX_VOICE_BYTES=3000000
